includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 10
    paths:
        - src
        - tests
        - rector.php
    excludePaths:
        - src/Components/*/resources/views
        - tests/Browser/resources
    tmpDir: build/phpstan
    reportUnmatchedIgnoredErrors: true
